# Portable-среда для локального запуска без прав администратора
.tools/

# Подложка карты: собирается командой npm run map:tiles из открытых данных.
# В репозитории не хранится — двенадцать мегабайт двоичного файла,
# который восстанавливается за полминуты.
apps/web/public/map/*.pmtiles

# Выгрузки базы: делаются по требованию командой pg_dump и живут
# ровно столько, сколько нужно. В репозитории им не место — это данные
# конкретного стенда, а не код, и они протухают в тот же день.
dumps/

# Отчёт проверки переводов: пересобирается командой npm run i18n:audit
# за секунду и устаревает при каждой правке словаря.
apps/web/i18n-report.json

# Рабочие материалы по экрану входа: фотография сотрудника и запись экрана.
# Репозиторий опубликован, а это персональные данные — им место в облаке
# предприятия, а не в открытой истории коммитов, откуда их уже не убрать.
Sing in page/
