{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    // rootDir = src, чтобы nest build клал точку входа в dist/main.js.
    // Скрипты из prisma/ собираются отдельным tsconfig.scripts.json.
    "rootDir": "./src",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    // Инкрементальная сборка здесь выключена намеренно. nest-cli чистит outDir
    // перед каждым запуском, а tsc по сохранённому tsbuildinfo решает, что
    // пересобирать нечего, — и dist остаётся пустым: «Cannot find module
    // dist/main» при живой сборке без единой ошибки. Выигрыш в секундах того
    // не стоит.
    "incremental": false,
    "strictPropertyInitialization": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // baseUrl не задаётся: он объявлен устаревшим и перестанет работать
    // в TypeScript 7.0. Пути в paths разрешаются относительно tsconfig.
    //
    // @gsm/shared намеренно НЕ маппится на исходники: пакет резолвится
    // через node_modules как собранный (packages/shared/dist), ровно так же,
    // как в рантайме. Маппинг на .ts втягивал бы файлы вне rootDir и ломал
    // сборку (TS6059). В режиме разработки dist пересобирается watch-режимом,
    // см. скрипт dev:shared в корневом package.json.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
