{
  "name": "@gsm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "prisma generate",
    "_comment:dotenv": "Prisma CLI ищет .env рядом со схемой; в монорепозитории он лежит в корне, поэтому подкладываем его через dotenv-cli.",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev && npm run db:apply-sql",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy && npm run db:apply-sql",
    "db:apply-sql": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register prisma/apply-sql.ts",
    "db:seed": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register prisma/seed.ts",
    "db:seed:demo": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register prisma/seed-demo.ts",
    "db:studio": "prisma studio",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force && npm run db:apply-sql && npm run db:seed"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@gsm/shared": "*",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.17.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/schematics": "^10.1.2",
    "@nestjs/testing": "^10.3.10",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^7.4.2",
    "jest": "^29.7.0",
    "prisma": "^5.17.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@gsm/shared$": "<rootDir>/../../../packages/shared/src/index.ts",
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
