# ────────────────────────────────────────────────────────────────────────────
# Скопируйте этот файл в .env и подставьте свои значения.
# .env в git не коммитится (см. .gitignore).
# ────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
TZ=Asia/Tashkent

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gsm
POSTGRES_USER=gsm_owner
POSTGRES_PASSWORD=change_me_owner

# Владелец схемы. Используется миграциями Prisma (RLS его не ограничивает).
DATABASE_URL="postgresql://gsm_owner:change_me_owner@localhost:5432/gsm?schema=public"

# Прикладной пользователь. Под ним работает API в рантайме — на него ДЕЙСТВУЮТ
# политики RLS. Разделение обязательно, иначе изоляция офисов не работает.
APP_DB_USER=gsm_app
APP_DB_PASSWORD=change_me_app
APP_DATABASE_URL="postgresql://gsm_app:change_me_app@localhost:5432/gsm?schema=public&connection_limit=20"

# ─── Redis (очереди, кэш, rate-limit) ───────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── MinIO / S3 (сканы документов, фото одометра, накладные) ────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gsm-files
S3_ACCESS_KEY=gsm_minio
S3_SECRET_KEY=change_me_minio
S3_FORCE_PATH_STYLE=true

# ─── API ────────────────────────────────────────────────────────────────────
API_PORT=3000
API_PREFIX=api
# localhost и 127.0.0.1 — разные origin для браузера, поэтому перечислены оба.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── JWT ────────────────────────────────────────────────────────────────────
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_REFRESH_TTL=30d

# ─── Пароли ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Seed (стартовый суперпользователь) ─────────────────────────────────────
SEED_ADMIN_EMAIL=admin@gsm.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_DEMO_DATA=true

# ─── Frontend ───────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api
VITE_DEFAULT_LOCALE=ru
